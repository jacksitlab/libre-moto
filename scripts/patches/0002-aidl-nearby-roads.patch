+	public boolean getNearbyRoads(@NonNull NearbyRoadsParams params,
+	                              @NonNull NearbyRoadsResult result) {
+		int maxRoadsRaw = params.getMaxRoads();
+		if (maxRoadsRaw <= 0) maxRoadsRaw = 50;
+		final int maxRoads = maxRoadsRaw;
+		int radiusM = params.getRadiusMeters();
+		if (radiusM <= 0) radiusM = 200;
+
+		// Get the active navigation route from OsmAnd
+		java.util.List<net.osmand.Location> routeLocs = null;
+		try {
+			routeLocs = app.getRoutingHelper().getRoute().getRouteLocations();
+			LOG.info("getNearbyRoads: route points=" + (routeLocs != null ? routeLocs.size() : 0));
+		} catch (Exception e) {
+			LOG.info("getNearbyRoads: could not get route: " + e.getMessage());
+		}
+		if (routeLocs == null || routeLocs.isEmpty()) return false;
+
+		// Limit route to first ~2km from vehicle (point 0) to keep bbox small
+		double minLat = 90, maxLat = -90, minLon = 180, maxLon = -180;
+		double routeDistM = 0;
+		int routeEnd = routeLocs.size();
+		for (int ri = 0; ri < routeLocs.size(); ri++) {
+			net.osmand.Location loc = routeLocs.get(ri);
+			if (ri > 0) {
+				routeDistM += loc.distanceTo(routeLocs.get(ri - 1));
+				if (routeDistM > 2000) { routeEnd = ri + 1; break; }
+			}
+			if (loc.getLatitude() < minLat) minLat = loc.getLatitude();
+			if (loc.getLatitude() > maxLat) maxLat = loc.getLatitude();
+			if (loc.getLongitude() < minLon) minLon = loc.getLongitude();
+			if (loc.getLongitude() > maxLon) maxLon = loc.getLongitude();
+		}
+		LOG.info("getNearbyRoads: route limited to " + routeEnd + "/" + routeLocs.size() + " pts (" + (int)routeDistM + "m)");
+		final int routeEndFinal = routeEnd;
+		double latPad = radiusM / 111320.0;
+		double lonPad = radiusM / (111320.0 * Math.cos(Math.toRadians((minLat + maxLat) / 2)));
+		int leftX = MapUtils.get31TileNumberX(minLon - lonPad);
+		int rightX = MapUtils.get31TileNumberX(maxLon + lonPad);
+		int topY = MapUtils.get31TileNumberY(maxLat + latPad);
+		int bottomY = MapUtils.get31TileNumberY(minLat - latPad);
+		int zoom = 17;
+		try {
+			zoom = app.getOsmandMap().getMapView().getZoom();
+		} catch (Exception e) { }
+		LOG.info("getNearbyRoads: route bbox lat[" + minLat + "," + maxLat + "] lon[" + minLon + "," + maxLon + "] zoom=" + zoom + " routePts=" + routeEndFinal);
+
+		java.util.List<ARoadPolyline> roads = new java.util.ArrayList<>();
+		int[] totalFound = {0};
+		java.util.Collection<net.osmand.plus.resources.BinaryMapReaderResource> fileReaders =
+				app.getResourceManager().getFileReaders();
+		if (fileReaders.isEmpty()) return false;
+		BinaryMapIndexReader.SearchRequest<BinaryMapDataObject> searchRequest =
+				BinaryMapIndexReader.buildSearchRequest(leftX, rightX, topY, bottomY, zoom, null);
+
+		// Build route point array in 31-bit coords for proximity check (limited route)
+		int[] routeX = new int[routeEndFinal];
+		int[] routeY = new int[routeEndFinal];
+		for (int i = 0; i < routeEndFinal; i++) {
+			routeX[i] = MapUtils.get31TileNumberX(routeLocs.get(i).getLongitude());
+			routeY[i] = MapUtils.get31TileNumberY(routeLocs.get(i).getLatitude());
+		}
+		// Proximity threshold in 31-bit tile units (~50m)
+		double proximityMeters = 50;
+		double tileWidthM = MapUtils.getTileDistanceWidth(zoom);
+		// 31-bit tile: 2^31 tiles across 360 degrees at zoom 0, so 1 tile unit ≈ 360/2^31 degrees
+		// At zoom Z, tile width = 360/2^Z degrees = 360*111320/2^Z meters
+		// 31-bit unit = (360*111320) / (2^31 * 2^Z) ... no, 31-bit is the FULL resolution
+		// 1 unit in 31-bit ≈ 0.0084 m at equator (360*111320 / 2^31 ≈ 0.0084 m)
+		double unitMeters = 40075000.0 / (1L << 31); // circumference / 2^31
+		double proximityUnits = proximityMeters / unitMeters;
+		double proximityUnitsSq = proximityUnits * proximityUnits;
+
+		try {
+			for (net.osmand.plus.resources.BinaryMapReaderResource resource : fileReaders) {
+				BinaryMapIndexReader reader = resource.getReader(net.osmand.plus.resources.ResourceManager.BinaryMapReaderResourceType.ROUTING);
+				if (reader == null) reader = resource.getShallowReader();
+				if (reader == null) continue;
+				for (RouteRegion reg : reader.getRoutingIndexes()) {
+					List<RouteSubregion> parent = zoom < 15 ? reg.getBaseSubregions() : reg.getSubregions();
+					List<RouteSubregion> searchResult = reader.searchRouteIndexTree(searchRequest, parent);
+					reader.loadRouteIndexData(searchResult, new ResultMatcher<RouteDataObject>() {
+						@Override
+						public boolean publish(RouteDataObject r) {
+							String highway = "";
+							int[] roTypes = r.getTypes();
+							for (int k = 0; k < roTypes.length; k++) {
+								RouteTypeRule rr = reg.quickGetEncodingRule(roTypes[k]);
+								if (rr != null && "highway".equals(rr.getTag())) {
+									highway = rr.getValue();
+									break;
+								}
+							}
+							if (highway.isEmpty()) return false;
+							// Skip non-vehicular ways
+							if (highway.equals("footway") || highway.equals("path") || highway.equals("cycleway")
+									|| highway.equals("steps") || highway.equals("pedestrian")
+									|| highway.equals("track") || highway.equals("bridleway"))
+								return false;
+
+							// Check if any road point is within proximityUnits of the route
+							int npts = r.getPointsLength();
+							boolean nearRoute = false;
+							for (int j = 0; j < npts && !nearRoute; j++) {
+								int rx = r.getPoint31XTile(j);
+								int ry = r.getPoint31YTile(j);
+								for (int i = 0; i < routeX.length && !nearRoute; i++) {
+									double dx = rx - routeX[i];
+									double dy = ry - routeY[i];
+									if (dx * dx + dy * dy < proximityUnitsSq) {
+										nearRoute = true;
+									}
+								}
+							}
+							if (!nearRoute) return false;
+
+							totalFound[0]++;
+							if (roads.size() >= maxRoads) return false;
+
+							java.util.ArrayList<net.osmand.aidlapi.map.ALatLon> pts = new java.util.ArrayList<>(npts);
+							for (int j = 0; j < npts; j++) {
+								pts.add(new net.osmand.aidlapi.map.ALatLon(
+										MapUtils.get31LatitudeY(r.getPoint31YTile(j)),
+										MapUtils.get31LongitudeX(r.getPoint31XTile(j))));
+							}
+							ARoadPolyline road = new ARoadPolyline();
+							road.setPoints(pts);
+							String name = "";
+							TIntObjectHashMap<String> names = r.getNames();
+							if (names != null && !names.isEmpty()) {
+								TIntObjectIterator<String> it = names.iterator();
+								if (it.hasNext()) { it.advance(); name = it.value(); }
+							}
+							road.setName(name);
+							road.setRoadType(highway);
+							roads.add(road);
+							return false;
+						}
+						@Override
+						public boolean isCancelled() {
+							return false;
+						}
+					});
+				}
+			}
+		} catch (java.io.IOException e) {
+			LOG.error("getNearbyRoads error", e);
+			return false;
+		}
+		LOG.info("getNearbyRoads: totalFound=" + totalFound[0] + " roads.size=" + roads.size());
+		if (roads.isEmpty()) return false;
+		result.setRoads(roads);
+		result.setTotalFound(totalFound[0]);
+		return true;
+	}
