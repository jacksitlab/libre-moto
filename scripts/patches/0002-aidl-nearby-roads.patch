+	public boolean getNearbyRoads(@NonNull NearbyRoadsParams params,
+	                              @NonNull NearbyRoadsResult result) {
+		double centerLat = params.getCenterLat();
+		double centerLon = params.getCenterLon();
+		int radiusM = params.getRadiusMeters();
+		int maxRoads = params.getMaxRoads();
+		if (maxRoads <= 0) maxRoads = 50;
+
+		// Compute bbox in WGS84
+		double latDelta = radiusM / 111320.0;
+		double lonDelta = radiusM / (111320.0 * Math.cos(Math.toRadians(centerLat)));
+		double southLat = centerLat - latDelta;
+		double northLat = centerLat + latDelta;
+		double westLon = centerLon - lonDelta;
+		double eastLon = centerLon + lonDelta;
+
+		// Convert to 31-bit tile coordinates
+		int leftX = MapUtils.get31TileNumberX(westLon);
+		int rightX = MapUtils.get31TileNumberX(eastLon);
+		int topY = MapUtils.get31TileNumberY(northLat);
+		int bottomY = MapUtils.get31TileNumberY(southLat);
+		int zoom = 15;
+
+		java.util.List<ARoadPolyline> roads = new java.util.ArrayList<>();
+		int totalFound = 0;
+
+		java.util.Collection<net.osmand.plus.resources.BinaryMapReaderResource> fileReaders =
+				app.getResourceManager().getFileReaders();
+		if (fileReaders.isEmpty()) {
+			return false;
+		}
+
+		try {
+			for (net.osmand.plus.resources.BinaryMapReaderResource resource : fileReaders) {
+				BinaryMapIndexReader reader = resource.getReader(
+						net.osmand.plus.resources.ResourceManager.BinaryMapReaderResourceType.REVERSE_GEOCODING);
+				if (reader == null) continue;
+
+				BinaryMapIndexReader.SearchRequest<BinaryMapDataObject> request =
+						BinaryMapIndexReader.buildSearchRequest(leftX, rightX, topY, bottomY, zoom, null);
+				java.util.List<BinaryMapDataObject> objects = reader.searchMapIndex(request);
+
+				for (BinaryMapDataObject obj : objects) {
+					if (obj.getObjectType() != RenderingRulesStorage.LINE_RULES) continue;
+					String highway = obj.getTagValue("highway");
+					if (highway == null) continue;
+
+					totalFound++;
+					if (roads.size() >= maxRoads) continue;
+
+					int[] coords = obj.getCoordinates();
+				int npts = obj.getPointsLength();
+				java.util.ArrayList<net.osmand.aidlapi.map.ALatLon> pts = new java.util.ArrayList<>(npts);
+				for (int i = 0; i < npts; i++) {
+					int x = coords[i * 2];
+					int y = coords[i * 2 + 1];
+					pts.add(new net.osmand.aidlapi.map.ALatLon(
+							MapUtils.get31LatitudeY(y), MapUtils.get31LongitudeX(x)));
+				}
+
+				ARoadPolyline road = new ARoadPolyline();
+				road.setPoints(pts);
+				road.setName(obj.getName() != null ? obj.getName() : "");
+				road.setRoadType(highway);
+				roads.add(road);
+			}
+				reader.close();
+			}
+		} catch (java.io.IOException e) {
+			LOG.error("getNearbyRoads: " + e.getMessage(), e);
+			return false;
+		}
+
+		if (roads.isEmpty()) {
+			return false;
+		}
+
+		result.setRoads(roads);
+		result.setTotalFound(totalFound);
+		return true;
+	}
