<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Logo oben + Menü-Button (⋮) rechts — in einem FrameLayout -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/logo"
            android:layout_width="204dp"
            android:layout_height="80dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:contentDescription="LibreMoto"
            android:src="@drawable/logo" />

        <!-- Overflow-Menü als simpler Text-Button (⋮): folgt der
             Theme-Textfarbe, ist auf jedem Gerät sichtbar — die
             Toolbar-Variante zeigte auf Samsung nur den Titel,
             aber keine drei Punkte. -->
        <TextView
            android:id="@+id/menu_btn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|end"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="Menü"
            android:gravity="center"
            android:text="⋮"
            android:textSize="26sp" />
    </FrameLayout>

    <!-- Verbindungsstatus -->
    <TextView
        android:id="@+id/ble_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="Verbinde …"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/ble_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text=""
        android:textSize="12sp" />

    <Button
        android:id="@+id/btn_retry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:minWidth="200dp"
        android:text="Erneut versuchen"
        android:visibility="gone" />

    <!-- Status der Karten/Route unten, dezent -->
    <TextView
        android:id="@+id/map_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text=""
        android:textSize="12sp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Log (Klapptext, default zu) -->
    <TextView
        android:id="@+id/log_toggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:text="Log ▸"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/log"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#00000011"
        android:fontFamily="monospace"
        android:gravity="bottom"
        android:maxHeight="200dp"
        android:padding="8dp"
        android:textSize="11sp"
        android:visibility="gone" />

    <!-- Build-Stempel: sofort erkennbar, welcher Stand installiert ist -->
    <TextView
        android:id="@+id/build_id"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="4dp"
        android:text=""
        android:textColor="#888888"
        android:textSize="10sp" />

</LinearLayout>
