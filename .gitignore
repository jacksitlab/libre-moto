# Build outputs (any build/ dir: Arduino, ESP-IDF, Gradle, CMake)
build/
*.elf
*.bin
*.hex
*.map

# ESP-IDF (firmware/esp-idf/) — generated per build
firmware/esp-idf/sdkconfig
firmware/esp-idf/sdkconfig.old
firmware/esp-idf/managed_components/
firmware/esp-idf/dependencies.lock

# IDE / editor
.vscode/
.idea/
*.iml
*.swp
*~
.DS_Store

# PlatformIO
.pio/

# Arduino IDE
ArduinoSketch/
*.ino.bak

# Android app (app/)
app/.gradle/
app/local.properties
app/gradle/wrapper/gradle-wrapper.jar
app/src/test/resources/*.pbf
app/src/test/resources/*.lmm

# CMake / CTest
CMakeCache.txt
CTestTestfile.cmake
Testing/

# Secrets
*.key
*.pem
.env
.env.local

# Logs
*.log

# Host unit-test binaries (compiled on the dev machine, not committed)
firmware/test/test_*
!firmware/test/*.cpp
!firmware/test/*.h

# OsmAnd fork build output
osmand-build

# Kilo AI tool
.kilo/
